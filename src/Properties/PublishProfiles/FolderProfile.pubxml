<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes to a FIXED path on purpose.

  RegistrationService writes this exe's absolute path into the Windows shell
  registration, so the location must be stable across updates. Do not switch this
  tool to the ClickOnce profile the sibling tools use - its version-stamped
  directories would break the registered handler on every publish.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>$(LOCALAPPDATA)\UrlRouter</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Worth it here (unlike the sibling tools): every link click is a cold start. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
